{
  "crons": [
    {
      "path": "/api/revenue-scheduler",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, X-Order-ID" }
      ]
    }
  ],
  "rewrites": [

    { "source": "/", "destination": "/docs/public_landing/index.html" },
    { "source": "/index.html", "destination": "/docs/public_landing/index.html" },
    { "source": "/success", "destination": "/docs/public_landing/success.html" },
    { "source": "/success.html", "destination": "/docs/public_landing/success.html" },
    { "source": "/cancel", "destination": "/docs/public_landing/cancel.html" },
    { "source": "/cancel.html", "destination": "/docs/public_landing/cancel.html" },
    { "source": "/sample", "destination": "/docs/public_landing/sample.html" },
    { "source": "/sample.html", "destination": "/docs/public_landing/sample.html" }
  ]
}

